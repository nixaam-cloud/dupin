<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- OLED & Dark Mode Surface Palette -->
    <Color x:Key="NotchBgColor">#F20B0B0D</Color>
    <Color x:Key="NotchCardBgColor">#1A1A1E</Color>
    <Color x:Key="NotchBorderColor">#33333A</Color>
    <Color x:Key="NotchBorderHoverColor">#50505C</Color>
    <Color x:Key="AccentColor">#6366F1</Color>
    <Color x:Key="AccentColorLight">#818CF8</Color>
    <Color x:Key="AccentGlowColor">#406366F1</Color>
    <Color x:Key="TextPrimaryColor">#F3F4F6</Color>
    <Color x:Key="TextSecondaryColor">#9CA3AF</Color>
    <Color x:Key="TextMutedColor">#6B7280</Color>

    <SolidColorBrush x:Key="NotchBackgroundBrush" Color="{StaticResource NotchBgColor}" />
    <SolidColorBrush x:Key="NotchCardBackgroundBrush" Color="{StaticResource NotchCardBgColor}" />
    <SolidColorBrush x:Key="NotchBorderBrush" Color="{StaticResource NotchBorderColor}" />
    <SolidColorBrush x:Key="NotchBorderHoverBrush" Color="{StaticResource NotchBorderHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentColorLight}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Subtle gradient for expanded header -->
    <LinearGradientBrush x:Key="NotchSurfaceGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F8121216" Offset="0" />
        <GradientStop Color="#F00B0B0E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PillBorderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4A4A56" Offset="0" />
        <GradientStop Color="#25252C" Offset="0.5" />
        <GradientStop Color="#3E3E4B" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>

<Application x:Class="WindowsNotch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsNotch"
             xmlns:conv="clr-namespace:WindowsNotch.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Icons.xaml" />
                <ResourceDictionary Source="Resources/Styles/NotchControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:NullToVisibilityConverter x:Key="NullToVisConv" />
            <conv:NullToVisibilityConverter x:Key="InverseNullToVisConv" Invert="True" />
            <conv:TabToVisibilityConverter x:Key="TabToVisConv" />
            <conv:BooleanToActiveLyricBrushConverter x:Key="ActiveLyricBrushConv" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConv" />
            <conv:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVisConv" />
            <BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

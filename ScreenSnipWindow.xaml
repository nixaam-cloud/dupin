<Window x:Class="WindowsNotch.ScreenSnipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dupin AI Screen Snip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        KeyDown="Window_KeyDown">

    <Grid x:Name="RootGrid"
          Background="#55000000"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          MouseMove="RootGrid_MouseMove"
          MouseLeftButtonUp="RootGrid_MouseLeftButtonUp"
          MouseRightButtonDown="RootGrid_MouseRightButtonDown">

        <!-- Top Instruction Pill -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,48,0,0"
                Background="#E612121A"
                BorderBrush="#8B5CF6"
                BorderThickness="1.5"
                CornerRadius="16"
                Padding="16,8"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource IconSnip}"
                      Fill="#A78BFA"
                      Width="14" Height="14"
                      Stretch="Uniform"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center" />
                <TextBlock Text="Drag to snip screen region for AI Vision Analysis  •  Press Esc or Right-Click to cancel"
                           Foreground="#FFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Marquee Selection Canvas -->
        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
            <!-- Marquee Selection Rectangle -->
            <Border x:Name="SelectionBorder"
                    Visibility="Collapsed"
                    Background="#18A78BFA"
                    BorderBrush="#A78BFA"
                    BorderThickness="2"
                    CornerRadius="4">
                <Border.Effect>
                    <DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                </Border.Effect>
            </Border>

            <!-- Live Dimensions Pill -->
            <Border x:Name="SizeBadge"
                    Visibility="Collapsed"
                    Background="#E6161622"
                    BorderBrush="#7C3AED"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6,2">
                <TextBlock x:Name="SizeText"
                           Text="0 × 0"
                           Foreground="#EDE9FE"
                           FontSize="10.5"
                           FontWeight="SemiBold" />
            </Border>
        </Canvas>
    </Grid>
</Window>

